# Copia este archivo a .env (se lee al arrancar con npm start) antes de usar el sistema fuera de pruebas.
PORT=3000
# Cambia este valor por una cadena larga y aleatoria; firma las sesiones.
JWT_SECRETO=cambia-este-secreto-en-produccion
# Pon 1 solo si publicas con HTTPS.
COOKIE_SEGURA=0
# Ruta del archivo SQLite (opcional).
# DB_PATH=./datos/estimador.db

# Dirección que usarán los expertos en los enlaces de invitación (si se deja vacía se usa la dirección con la que se abrió el sistema).
# BASE_URL=http://192.168.1.15:3000
# Correo saliente (opcional). Sin SMTP_HOST los correos se guardan y el moderador copia el enlace manualmente.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASS=contraseña-de-aplicación
# SMTP_FROM="Estimador UCE <tucuenta@gmail.com>"
